{
  "name": "soull",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.4.0"
  },
  "bin": {
    "soull": "./bin/soull.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "service": "node service/server.mjs",
    "build": "node scripts/build.mjs",
    "start": "node service/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "native:build": "sh scripts/build-native.sh",
    "native": "open native/build/SoullDev.app",
    "test:browser": "node tests/browser/conversations.mjs && node tests/browser/reviews.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "playwright": "1.65.1",
    "typescript": "5.9.3"
  }
}
